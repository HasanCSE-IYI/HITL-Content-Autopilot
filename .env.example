# ==========================================
# HITL Content Autopilot Configuration
# ==========================================

# 1. Google Gemini AI API
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 2. Amazon Associates Credentials
AMAZON_ASSOCIATE_TAG=yourtag-20
AMAZON_COUNTRY=com

# Optional: Official Amazon PA-API 5.0 (Leave blank if using built-in Smart Scraper)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=

# 3. WordPress Publishing Integration (REST API)
WORDPRESS_URL=https://yourwebsite.com
WORDPRESS_USERNAME=your_wp_username
# Generate Application Password in: WordPress Admin > Users > Profile > Application Passwords
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WORDPRESS_DEFAULT_STATUS=draft
